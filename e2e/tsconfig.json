{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@playwright/test", "node"],
    "noEmit": true
  },
  // The seed script imports backend-only deps (dotenv, bcryptjs, generated
  // Prisma client). It's run via `tsx` from `backend/` (see package.json
  // `test:e2e:setup` script), so exclude it from root-level type-check.
  "include": ["**/*.ts"],
  "exclude": ["setup/**"]
}
