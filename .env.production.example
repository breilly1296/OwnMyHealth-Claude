# OwnMyHealth Frontend - PRODUCTION Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# These environment variables are embedded at BUILD TIME by Vite.
# Set them in your CI / host build environment before building the frontend
# (the production frontend is built in CI and served from a GCS bucket).
#
# ═══════════════════════════════════════════════════════════════════════════════

# Backend API URL (the deployed backend service URL)
VITE_API_URL=https://api.ownmyhealth.io
