# ═══════════════════════════════════════════════════════════════════════════════
# OwnMyHealth Backend - PRODUCTION Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# IMPORTANT: Production runs on GCP Cloud Run (backend) + Cloud SQL (database).
# Set these as Cloud Run service env vars / Secret Manager references — NOT in a
# committed file. (Railway was decommissioned; older notes referencing it are stale.)
#
# Generate secure secrets with:
#   openssl rand -base64 32    (for JWT secrets)
#   openssl rand -hex 32       (for PHI encryption key / audit salt)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
# PORT is provided by Cloud Run ($PORT); the app defaults to 3001 if unset.

# ───────────────────────────────────────────────────────────────────────────────
# Database (Cloud SQL via Cloud SQL Auth Proxy / connector)
# ───────────────────────────────────────────────────────────────────────────────
# REQUIRED. Point at the Cloud SQL Postgres instance (Secret Manager reference).
DATABASE_URL=

# ───────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ───────────────────────────────────────────────────────────────────────────────
# REQUIRED. Missing or empty causes the app to crash at startup — no fallback.
# Generate fresh per environment with: openssl rand -base64 32
# Must be at least 32 characters. Never commit real values.
JWT_ACCESS_SECRET=
# Expressed as integer seconds — the runtime config parses
# `parseInt(process.env.JWT_*_EXPIRES_SECONDS)`. Prior names ending `_IN=15m`
# matched neither config/index.ts nor jsonwebtoken's expiresIn-as-number
# convention; renamed 2026-04-24 to match what the code actually reads.
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_SECONDS=604800

# ───────────────────────────────────────────────────────────────────────────────
# PHI Encryption - CRITICAL: Generate and backup securely!
# ───────────────────────────────────────────────────────────────────────────────
PHI_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Audit log encryption salt. REQUIRED — boot hard-fails if missing/<16 chars.
# For a fresh environment: openssl rand -hex 32.
# For an existing prod env with historic audit logs: extract the plaintext salt
# from system_config.audit_encryption_salt (decrypt with PHI_ENCRYPTION_KEY)
# before setting this — rotating it makes past audit logs undecryptable.
AUDIT_LOG_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32

# ───────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API (see C-7 in SECURITY_STATUS.md)
# ───────────────────────────────────────────────────────────────────────────────
# Set ANTHROPIC_BAA_ACTIVE=true only after confirming a signed BAA.
# REQUIRED in production when ANTHROPIC_API_KEY is set — app refuses to boot
# otherwise. The runtime gate in claudeExtraction / sbcExtraction also throws
# if this is false, so an accidental unset disables PHI→Claude paths.
ANTHROPIC_API_KEY=
ANTHROPIC_BAA_ACTIVE=false

# ───────────────────────────────────────────────────────────────────────────────
# CORS - Set to your frontend domain
# ───────────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://ownmyhealth.io

# ───────────────────────────────────────────────────────────────────────────────
# Security
# ───────────────────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
# 13 rounds minimum for healthcare/HIPAA workloads (matches config/index.ts default).
BCRYPT_ROUNDS=13

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────────────────────
# Note: Demo mode is automatically disabled in production for security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────────────────────────
# Email (SendGrid)
# ───────────────────────────────────────────────────────────────────────────────
# Get your API key from https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day
SENDGRID_API_KEY=SG.your_api_key_here
EMAIL_FROM=noreply@ownmyhealth.io
EMAIL_FROM_NAME=OwnMyHealth
FRONTEND_URL=https://ownmyhealth.io
# DO NOT set SENDGRID_SANDBOX_MODE=true in production — sandbox validates but
# never delivers, silently breaking verification/password-reset email. The app
# hard-fails at boot if it is "true" in production.

# ───────────────────────────────────────────────────────────────────────────────
# Google Cloud Platform (Cloud Storage + Document AI OCR)
# ───────────────────────────────────────────────────────────────────────────────
# GCS_BUCKET_NAME is REQUIRED in production (boot hard-fails if unset — F-28).
GCS_BUCKET_NAME=ownmyhealth-user-files
GCP_PROJECT_ID=ownmyhealth-prod
# Document AI OCR for scanned lab reports (optional). If GCP_PROCESSOR_ID is set,
# GOOGLE_BAA_ACTIVE must be "true" in production or the app refuses to boot.
# GCP_PROCESSOR_ID=
# GCP_LOCATION=us
# On Cloud Run, prefer Workload Identity (Application Default Credentials) over a
# JSON key. Set GOOGLE_APPLICATION_CREDENTIALS only if injecting a key explicitly.
# GOOGLE_APPLICATION_CREDENTIALS=
# Set to "true" only after confirming a signed Google Cloud BAA covering Document AI.
GOOGLE_BAA_ACTIVE=false

# ───────────────────────────────────────────────────────────────────────────────
# AI Spend Circuit Breaker (M-4)
# ───────────────────────────────────────────────────────────────────────────────
# Rolling per-UTC-day budgets (USD). 0 disables a scope; a NaN/negative value
# warns at boot and falls back to the default (breaker stays ON), not a hard-fail.
AI_DAILY_BUDGET_USD=50
AI_USER_DAILY_BUDGET_USD=5

# ───────────────────────────────────────────────────────────────────────────────
# Optional: shared rate-limit / scheduler infra (see backend/.env.example)
# ───────────────────────────────────────────────────────────────────────────────
# REDIS_URL — shared rate-limit store (Cloud Memorystore) for multi-instance
# accuracy. Unset → per-instance in-memory counters (bounded by --max-instances).
# REDIS_URL=
# AUDIT_CLEANUP_TOKEN — shared secret to drive audit-retention cleanup from Cloud
# Scheduler (POST /api/v1/internal/audit-cleanup, header X-Cleanup-Token). When
# set, the in-process 24h interval (which rarely fires on scale-to-zero) is disabled.
# AUDIT_CLEANUP_TOKEN=
