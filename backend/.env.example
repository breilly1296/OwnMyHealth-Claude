# ═══════════════════════════════════════════════════════════════════════════════
# OwnMyHealth Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and update the values for your environment.
# NEVER commit .env to version control!
#
# For production, all variables marked [REQUIRED IN PRODUCTION] must be set
# to secure, unique values.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Environment: development | production | test
NODE_ENV=development

# Server port (default: 3001)
PORT=3001

# ───────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────────────────

# [REQUIRED IN PRODUCTION] PostgreSQL connection string
# For local Prisma Postgres development, run: npx prisma dev
# For production, use your PostgreSQL server URL
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY"

# ───────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ───────────────────────────────────────────────────────────────────────────────

# REQUIRED in every environment (dev, staging, preview, prod).
# Missing or empty causes the app to crash at startup — no fallback.
# Generate a fresh value per environment with: openssl rand -base64 32
# Must be at least 32 characters. Never commit real values.
JWT_ACCESS_SECRET=

# Access token expiration in SECONDS (default: 900 = 15 minutes)
# Note: Must be an integer, NOT a string like "15m"
JWT_ACCESS_EXPIRES_SECONDS=900

# REQUIRED in every environment (dev, staging, preview, prod).
# Missing or empty causes the app to crash at startup — no fallback.
# Generate a fresh value per environment with: openssl rand -base64 32
# Must be at least 32 characters. Never commit real values.
JWT_REFRESH_SECRET=

# Refresh token expiration in SECONDS (default: 604800 = 7 days)
# Note: Must be an integer, NOT a string like "7d"
JWT_REFRESH_EXPIRES_SECONDS=604800

# ───────────────────────────────────────────────────────────────────────────────
# PHI Encryption (Protected Health Information)
# ───────────────────────────────────────────────────────────────────────────────

# REQUIRED in every environment (dev, staging, preview, prod).
# CRITICAL: This key encrypts all Protected Health Information (PHI).
#
# Requirements (enforced at startup — app refuses to boot otherwise):
#   - Must be exactly 64 hexadecimal characters (256 bits)
#   - Must contain only valid hex characters (0-9, a-f, A-F)
#   - Must NOT be a known placeholder/insecure value (see INSECURE_KEYS in
#     backend/src/services/encryption.ts)
#
# Generate a fresh value per environment with:
#   openssl rand -hex 32
#
# IMPORTANT: Store this key securely! If lost, all encrypted PHI data becomes
# unrecoverable. Use Secret Manager / Railway variables in deployed envs.
#
# The placeholder below contains underscores (non-hex chars) so it deliberately
# fails validation. That makes "copied .env.example and forgot to edit it" a
# loud, fast failure instead of silent insecurity. Never commit real values.
PHI_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# ───────────────────────────────────────────────────────────────────────────────
# Account Security
# ───────────────────────────────────────────────────────────────────────────────

# Maximum failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes (default: 30)
LOCKOUT_DURATION_MINUTES=30

# Bcrypt hashing rounds (default: 12, higher = more secure but slower)
# Recommended: 12 for most cases, 14+ for high-security environments
BCRYPT_ROUNDS=12

# ───────────────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ───────────────────────────────────────────────────────────────────────────────

# Allowed origin for CORS requests
# In development, multiple localhost ports are allowed by default
# In production, set to your frontend domain (e.g., https://app.example.com)
# CORS_ORIGIN=https://app.example.com

# ───────────────────────────────────────────────────────────────────────────────
# Cookie Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Cookie SameSite policy: strict | lax | none
# - For same-domain: use 'lax' (default) or 'strict'
# - For cross-domain (frontend on domain.com, API on api.domain.com): MUST use 'none'
# When COOKIE_DOMAIN is set, defaults to 'none' for cross-domain support
# COOKIE_SAME_SITE=none

# Cookie domain (for cross-subdomain cookies)
# Required for cross-domain setups where frontend and API are on different subdomains
# Example: frontend at ownmyhealth.io, API at api.ownmyhealth.io
# Set to the root domain with leading dot: .ownmyhealth.io
# COOKIE_DOMAIN=.ownmyhealth.io

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────────────────────

# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────────────────────────
# Demo Account (Development Only)
# ───────────────────────────────────────────────────────────────────────────────

# Enable demo account (default: false)
# IMPORTANT: Cannot be enabled in production - server will refuse to start
# DEMO_ACCOUNT_ENABLED=true

# Demo account email
# DEMO_EMAIL=demo@example.com

# Demo account password - CHANGE THIS in any shared/deployed environment!
# Generate a new password with: openssl rand -base64 16
DEMO_PASSWORD=Demo123!

# ───────────────────────────────────────────────────────────────────────────────
# CSRF Protection
# ───────────────────────────────────────────────────────────────────────────────

# Disable CSRF protection (development only!)
# NEVER set this in production - CSRF protection is required for security
# DISABLE_CSRF=true

# ───────────────────────────────────────────────────────────────────────────────
# External APIs
# ───────────────────────────────────────────────────────────────────────────────

# CMS Marketplace API (Healthcare.gov)
# Obtain API key from: https://developer.cms.gov/
# Used for coverage lookup and provider search features
CMS_API_KEY=
# Optional: Override the API base URL (default: https://marketplace.api.healthcare.gov/api/v1)
# CMS_API_BASE_URL=https://marketplace.api.healthcare.gov/api/v1
# Optional: API request timeout in milliseconds (default: 30000)
# CMS_API_TIMEOUT_MS=30000

# OpenAI API Key (for AI-powered health insights)
# OPENAI_API_KEY=your-openai-api-key

# Anthropic API Key (for AI-powered biomarker guidance)
# Get your API key from: https://console.anthropic.com/
# Used for educational health guidance in the Trends feature
ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Production Checklist
# ═══════════════════════════════════════════════════════════════════════════════
#
# Before deploying to production, ensure you have:
#
# [ ] Set NODE_ENV=production
# [ ] Set DATABASE_URL to your production PostgreSQL
# [ ] Generated and set JWT_ACCESS_SECRET (openssl rand -base64 32)
# [ ] Generated and set JWT_REFRESH_SECRET (openssl rand -base64 32)
# [ ] Generated and set PHI_ENCRYPTION_KEY (openssl rand -hex 32)
# [ ] Set CORS_ORIGIN to your frontend domain
# [ ] Configured HTTPS/TLS for your server
# [ ] Set up proper secrets management (e.g., AWS Secrets Manager, HashiCorp Vault)
# [ ] Backed up your PHI_ENCRYPTION_KEY securely (data recovery depends on it!)
#
# ═══════════════════════════════════════════════════════════════════════════════
