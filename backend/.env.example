# ═══════════════════════════════════════════════════════════════════════════════
# OwnMyHealth Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and update the values for your environment.
# NEVER commit .env to version control!
#
# For production, all variables marked [REQUIRED IN PRODUCTION] must be set
# to secure, unique values.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Environment: development | production | test
NODE_ENV=development

# Server port (default: 3001)
PORT=3001

# ───────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────────────────────────

# [REQUIRED IN PRODUCTION] PostgreSQL connection string
# For local Prisma Postgres development, run: npx prisma dev
# For production, use your PostgreSQL server URL
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_API_KEY"

# Max size of the pg connection pool (default: 10). Tune up only if you hit
# "all connections busy" under burst load; keep within Cloud SQL's max_connections.
# DATABASE_POOL_SIZE=10

# ───────────────────────────────────────────────────────────────────────────────
# JWT Authentication
# ───────────────────────────────────────────────────────────────────────────────

# REQUIRED in every environment (dev, staging, preview, prod).
# Missing or empty causes the app to crash at startup — no fallback.
# Generate a fresh value per environment with: openssl rand -base64 32
# Must be at least 32 characters. Never commit real values.
JWT_ACCESS_SECRET=

# Access token expiration in SECONDS (default: 900 = 15 minutes)
# Note: Must be an integer, NOT a string like "15m"
JWT_ACCESS_EXPIRES_SECONDS=900

# REQUIRED in every environment (dev, staging, preview, prod).
# Missing or empty causes the app to crash at startup — no fallback.
# Generate a fresh value per environment with: openssl rand -base64 32
# Must be at least 32 characters. Never commit real values.
JWT_REFRESH_SECRET=

# Refresh token expiration in SECONDS (default: 604800 = 7 days)
# Note: Must be an integer, NOT a string like "7d"
JWT_REFRESH_EXPIRES_SECONDS=604800

# ───────────────────────────────────────────────────────────────────────────────
# PHI Encryption (Protected Health Information)
# ───────────────────────────────────────────────────────────────────────────────

# REQUIRED in every environment (dev, staging, preview, prod).
# CRITICAL: This key encrypts all Protected Health Information (PHI).
#
# Requirements (enforced at startup — app refuses to boot otherwise):
#   - Must be exactly 64 hexadecimal characters (256 bits)
#   - Must contain only valid hex characters (0-9, a-f, A-F)
#   - Must NOT be a known placeholder/insecure value (see INSECURE_KEYS in
#     backend/src/services/encryption.ts)
#
# Generate a fresh value per environment with:
#   openssl rand -hex 32
#
# IMPORTANT: Store this key securely! If lost, all encrypted PHI data becomes
# unrecoverable. Use GCP Secret Manager (Cloud Run secret refs) in deployed envs.
#
# The placeholder below contains underscores (non-hex chars) so it deliberately
# fails validation. That makes "copied .env.example and forgot to edit it" a
# loud, fast failure instead of silent insecurity. Never commit real values.
PHI_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# Audit log encryption salt. Moved from system_config to env var in C-8 so
# boot doesn't require an admin-bypass DB call (blocks NOBYPASSRLS cutover).
# For a fresh environment: generate with `openssl rand -hex 32`.
# For an existing environment with historic audit logs: extract the plaintext
# salt from system_config.audit_encryption_salt (decrypt with PHI_ENCRYPTION_KEY)
# and paste it here; rotating silently breaks decryption of past audit logs.
AUDIT_LOG_SALT=REPLACE_WITH_openssl_rand_hex_32

# ───────────────────────────────────────────────────────────────────────────────
# RLS Enforcement (C-8)
# ───────────────────────────────────────────────────────────────────────────────
# NOTE: the transitional RLS_ENFORCEMENT=strict flag was REMOVED at the omh_app
# NOBYPASSRLS cutover and is no longer read by any code. The BYPASSRLS posture is
# now unconditional in database.ts → assertNoBypassRLS() (production hard-exits,
# dev/staging warn). Do not re-add RLS_ENFORCEMENT — setting it has no effect.

# ───────────────────────────────────────────────────────────────────────────────
# Account Security
# ───────────────────────────────────────────────────────────────────────────────

# Maximum failed login attempts before account lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in minutes (default: 30)
LOCKOUT_DURATION_MINUTES=30

# Bcrypt hashing rounds (default: 13 — matches config/index.ts)
# Recommended: 13 minimum for healthcare/HIPAA workloads (2024+), 14+ for
# high-security environments. Higher = more secure but slower per hash.
BCRYPT_ROUNDS=13

# ───────────────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ───────────────────────────────────────────────────────────────────────────────

# Allowed origin for CORS requests
# In development, multiple localhost ports are allowed by default
# In production, set to your frontend domain (e.g., https://app.example.com)
# CORS_ORIGIN=https://app.example.com

# ───────────────────────────────────────────────────────────────────────────────
# Cookie Configuration
# ───────────────────────────────────────────────────────────────────────────────

# Cookie SameSite policy: strict | lax | none
# - For same-domain: use 'lax' (default) or 'strict'
# - For cross-domain (frontend on domain.com, API on api.domain.com): MUST use 'none'
# When COOKIE_DOMAIN is set, defaults to 'none' for cross-domain support
# COOKIE_SAME_SITE=none

# Cookie domain (for cross-subdomain cookies)
# Required for cross-domain setups where frontend and API are on different subdomains
# Example: frontend at ownmyhealth.io, API at api.ownmyhealth.io
# Set to the root domain with leading dot: .ownmyhealth.io
# COOKIE_DOMAIN=.ownmyhealth.io

# ───────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────────────────────────

# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Optional shared rate-limit store (audit #37). When set, ALL rate limiters use
# a Redis (Cloud Memorystore) store so counters are consistent across Cloud Run
# instances instead of per-instance in-memory counters (which let an attacker
# get N×limit across N instances). Leave UNSET to keep the in-memory default.
# Only enable after provisioning + monitoring Redis — if Redis is unreachable,
# rate-limited requests will error rather than silently skip the limit.
# REDIS_URL=redis://10.0.0.3:6379

# ───────────────────────────────────────────────────────────────────────────────
# Scheduled maintenance (audit #38)
# ───────────────────────────────────────────────────────────────────────────────
# Audit-log retention cleanup (7-year HIPAA window) runs via an in-process 24h
# setInterval by default — which rarely fires on scale-to-zero Cloud Run. Set
# this shared secret to instead drive cleanup from Cloud Scheduler hitting
# POST /api/v1/internal/audit-cleanup with header `X-Cleanup-Token: <value>`.
# When set, the in-process interval is disabled and the endpoint is enabled;
# when unset, the endpoint returns 404 and the interval runs (current behavior).
# Generate with: openssl rand -base64 32
# AUDIT_CLEANUP_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────
# Demo Account (Development Only)
# ───────────────────────────────────────────────────────────────────────────────

# Enable demo account (default: false)
# IMPORTANT: Cannot be enabled in production - server will refuse to start
# DEMO_ACCOUNT_ENABLED=true

# Demo account email
# DEMO_EMAIL=demo@example.com

# Demo account password - CHANGE THIS in any shared/deployed environment!
# Generate a new password with: openssl rand -base64 16
DEMO_PASSWORD=CHANGE_ME_run_openssl_rand_base64_16

# ───────────────────────────────────────────────────────────────────────────────
# CSRF Protection
# ───────────────────────────────────────────────────────────────────────────────

# Disable CSRF protection (development only!)
# NEVER set this in production - CSRF protection is required for security
# DISABLE_CSRF=true

# ───────────────────────────────────────────────────────────────────────────────
# Email (SendGrid)
# ───────────────────────────────────────────────────────────────────────────────

# SendGrid API key (transactional email: verification, password reset).
# Get one at https://app.sendgrid.com/settings/api_keys (free tier: 100/day).
# Leave blank to disable email entirely (config.email.enabled is derived from
# whether this is set). When unset, verification/password-reset emails won't send.
SENDGRID_API_KEY=

# "From" address for outbound email. Must be a verified SendGrid sender.
# Default if unset: noreply@ownmyhealth.com
EMAIL_FROM=noreply@ownmyhealth.com

# Display name shown on outbound email (default: OwnMyHealth)
EMAIL_FROM_NAME=OwnMyHealth

# Base URL used to build links inside emails (verification, reset).
# Default if unset: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SendGrid sandbox mode — validates requests (templates, recipients) but NEVER
# actually delivers, while the app still reports success. Staging forces this on
# (NODE_ENV=staging) so test flows don't spam real users. Production HARD-FAILS
# at boot if this is "true" (silently dropping auth email is unacceptable in prod).
# SENDGRID_SANDBOX_MODE=true

# ───────────────────────────────────────────────────────────────────────────────
# Google Cloud Platform (Cloud Storage + Document AI OCR)
# ───────────────────────────────────────────────────────────────────────────────

# GCS bucket for user file uploads (lab reports, SBC documents).
# Dev/staging fall back to 'ownmyhealth-user-files'; production HARD-FAILS at
# boot if unset (F-28) so PHI is never written to the wrong namespace.
# GCS_BUCKET_NAME=ownmyhealth-user-files

# GCP project ID — required for Cloud Storage and Document AI OCR.
# GCP_PROJECT_ID=

# Document AI processor ID (scanned lab-report OCR). When set, GOOGLE_BAA_ACTIVE
# must be "true" in production or the app refuses to boot (image OCR ships raw
# pixels carrying demographics to Google).
# GCP_PROCESSOR_ID=

# Document AI processor location (default: us)
# GCP_LOCATION=us

# Path to a GCP service-account credentials JSON file, OR the raw JSON content
# itself (ocrService parses inline JSON if the value starts with '{'). Leave
# unset to use Application Default Credentials (Workload Identity on Cloud Run).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Business Associate Agreement flag for Google Document AI (mirrors the
# Anthropic C-7 gate). Set "true" only after confirming a signed Google Cloud
# BAA covering Document AI. Required in production when GCP_PROCESSOR_ID is set,
# or the app refuses to boot; dev/staging boot with a warning and the runtime
# gate in ocrService blocks image OCR.
GOOGLE_BAA_ACTIVE=false

# ───────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API
# ───────────────────────────────────────────────────────────────────────────────

# Anthropic API Key (for AI-powered biomarker guidance)
# Get your API key from: https://console.anthropic.com/
# Used for educational health guidance in the Trends feature
ANTHROPIC_API_KEY=

# Business Associate Agreement flag (see C-7 in SECURITY_STATUS.md).
# Set to "true" after confirming a signed BAA with Anthropic. Required
# in production when ANTHROPIC_API_KEY is set, or the app refuses to boot.
# In dev/staging the app boots with a warning but Claude calls throw
# from the runtime gate in claudeExtraction / sbcExtraction.
ANTHROPIC_BAA_ACTIVE=false

# ───────────────────────────────────────────────────────────────────────────────
# AI Spend Circuit Breaker (M-4)
# ───────────────────────────────────────────────────────────────────────────────
# Rolling per-UTC-day budgets enforced by the aiSpendGuard middleware. 0 disables
# that scope. A NaN/negative value (env typo) WARNS at boot and falls back to the
# default — so the breaker stays ON rather than being silently neutered (it does
# NOT hard-fail boot). NOTE: the accumulator is in-memory/per-instance, so under
# Cloud Run autoscale the effective ceiling is N×budget (bounded by --max-instances;
# a shared store / REDIS_URL is the multi-instance fix).
# AI_DAILY_BUDGET_USD: global per-day cap across all users (default: 50)
AI_DAILY_BUDGET_USD=50
# AI_USER_DAILY_BUDGET_USD: per-user per-day cap (default: 5)
AI_USER_DAILY_BUDGET_USD=5

# ─────────────────────────────────────────────────────────────────────────────
# Quest Diagnostics SMART on FHIR Integration (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Sandbox credentials obtained by submitting the access request form at
# https://www.questdiagnostics.com/content/dam/corporate/restricted/documents/qps_qecs/Quanum_EHR_FHIR_API_Access_Request_Form.pdf
# Leave blank to disable the feature entirely (the "Connect Quest" button
# returns 503). Set QUEST_FHIR_BASE_URL to the mock server URL during
# local dev: http://localhost:3001/api/v1/mock-fhir/r4
QUEST_FHIR_CLIENT_ID=
QUEST_FHIR_CLIENT_SECRET=
QUEST_FHIR_BASE_URL=https://api.questdiagnostics.com/fhir/r4
QUEST_FHIR_REDIRECT_URI=https://api.ownmyhealth.io/api/v1/fhir/callback
# Where the OAuth callback redirects users on success.
QUEST_FHIR_SUCCESS_REDIRECT=http://localhost:5173/settings?labConnected=quest
# SSRF/exfil allowlist: comma-separated extra hosts (besides the FHIR base host)
# the SMART authorize/token/revoke endpoints may live on. Empty ⇒ those endpoints
# must be on the FHIR base host. The patient Bearer token and OAuth client_secret
# are only ever sent to these hosts.
# QUEST_FHIR_AUTH_HOSTS=login.questdiagnostics.com,auth.questdiagnostics.com

# ═══════════════════════════════════════════════════════════════════════════════
# Production Checklist
# ═══════════════════════════════════════════════════════════════════════════════
#
# Before deploying to production, ensure you have:
#
# [ ] Set NODE_ENV=production
# [ ] Set DATABASE_URL to your production PostgreSQL (Cloud SQL)
# [ ] Generated and set JWT_ACCESS_SECRET (openssl rand -base64 32)
# [ ] Generated and set JWT_REFRESH_SECRET (openssl rand -base64 32)
# [ ] Generated and set PHI_ENCRYPTION_KEY (openssl rand -hex 32)
# [ ] Set AUDIT_LOG_SALT (existing env: migrate the historic salt — see comment above)
# [ ] Set GCS_BUCKET_NAME (boot hard-fails in prod if unset)
# [ ] If ANTHROPIC_API_KEY is set: ANTHROPIC_BAA_ACTIVE=true (else boot hard-fails)
# [ ] If GCP_PROCESSOR_ID is set: GOOGLE_BAA_ACTIVE=true (else boot hard-fails)
# [ ] Confirm SENDGRID_SANDBOX_MODE is NOT true (boot hard-fails in prod if true)
# [ ] Set CORS_ORIGIN to your frontend domain
# [ ] Configured HTTPS/TLS for your server
# [ ] Set up proper secrets management (GCP Secret Manager → Cloud Run secret refs)
# [ ] Backed up your PHI_ENCRYPTION_KEY and AUDIT_LOG_SALT securely (recovery depends on them!)
#
# ═══════════════════════════════════════════════════════════════════════════════
