# ═══════════════════════════════════════════════════════════════════════════════
# OwnMyHealth Backend - STAGING Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Staging is production-like but intentionally quarantined:
#   - Separate Cloud SQL database (or at minimum a separate database on the
#     same instance — see docs/STAGING.md)
#   - SendGrid sandbox mode: emails are validated but never delivered
#   - ANTHROPIC_BAA_ACTIVE=false: Claude calls are blocked by the runtime gate
#   - Demo account enabled for manual test flows
#
# Generate secrets fresh for staging — NEVER reuse production values:
#   openssl rand -base64 32    (JWT secrets)
#   openssl rand -hex 32       (PHI encryption key)
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=staging
PORT=3001

# ───────────────────────────────────────────────────────────────────────────────
# Database — separate instance or separate DB from production
# ───────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:***@<staging-db-host>:5432/ownmyhealth_staging

# ───────────────────────────────────────────────────────────────────────────────
# JWT + PHI encryption — generate fresh, do NOT copy from prod
# ───────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_SECONDS=604800
PHI_ENCRYPTION_KEY=

# ───────────────────────────────────────────────────────────────────────────────
# Anthropic — BAA deliberately OFF in staging. Real PHI must never land here.
# The runtime gate in claudeExtraction / sbcExtraction will block Claude calls.
# ───────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BAA_ACTIVE=false

# ───────────────────────────────────────────────────────────────────────────────
# CORS — staging frontend origin
# ───────────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://staging.ownmyhealth.io

# ───────────────────────────────────────────────────────────────────────────────
# Cookies — staging is cross-domain (staging.ownmyhealth.io ↔ api-staging)
# ───────────────────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=.ownmyhealth.io
COOKIE_SAME_SITE=none

# ───────────────────────────────────────────────────────────────────────────────
# Security
# ───────────────────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
BCRYPT_ROUNDS=12

# ───────────────────────────────────────────────────────────────────────────────
# Rate limiting — match production so staging surfaces rate-limit bugs
# ───────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────────────────────────
# Email — SendGrid in sandbox mode. Emails validate but never send.
# ───────────────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_SANDBOX_MODE=true
EMAIL_FROM=noreply@staging.ownmyhealth.io
EMAIL_FROM_NAME=OwnMyHealth (Staging)
FRONTEND_URL=https://staging.ownmyhealth.io

# ───────────────────────────────────────────────────────────────────────────────
# Demo account — enabled in staging for smoke-test flows
# ───────────────────────────────────────────────────────────────────────────────
DEMO_ACCOUNT_ENABLED=true
DEMO_EMAIL=demo@ownmyhealth.io
DEMO_PASSWORD=DemoPassword123!

# ───────────────────────────────────────────────────────────────────────────────
# GCP — separate staging bucket to keep test files out of production storage
# ───────────────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=ownmyhealth-prod
GCS_BUCKET_NAME=ownmyhealth-user-files-staging

# ───────────────────────────────────────────────────────────────────────────────
# Feature flags
# ───────────────────────────────────────────────────────────────────────────────
QUEST_FHIR_CLIENT_ID=
QUEST_FHIR_CLIENT_SECRET=
QUEST_FHIR_BASE_URL=https://api.questdiagnostics.com/fhir/r4
QUEST_FHIR_REDIRECT_URI=https://api-staging.ownmyhealth.io/api/v1/fhir/callback
QUEST_FHIR_SUCCESS_REDIRECT=https://staging.ownmyhealth.io/settings?labConnected=quest
