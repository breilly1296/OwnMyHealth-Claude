// ===========================
// EXPENSE TRACKING & COST OPTIMIZATION
// ===========================

model ExpenseProjection {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  planId                 String   @map("plan_id") @db.Uuid
  serviceTypeEncrypted   String   @map("service_type") @db.Text
  estimatedCostEncrypted String   @map("estimated_cost") @db.Text
  frequencyPerYear       Int      @default(1) @map("frequency_per_year")
  isInNetwork            Boolean  @default(true) @map("is_in_network")
  notesEncrypted         String?  @map("notes") @db.Text
  projectionDate         DateTime @default(now()) @map("projection_date") @db.Date
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    InsurancePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  actuals ExpenseActual[]

  @@index([userId, planId])
  @@index([createdAt])
  @@map("expense_projections")
}

model ExpenseActual {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                       String    @map("user_id") @db.Uuid
  planId                       String    @map("plan_id") @db.Uuid
  projectionId                 String?   @map("projection_id") @db.Uuid
  serviceTypeEncrypted         String    @map("service_type") @db.Text
  providerNameEncrypted        String?   @map("provider_name") @db.Text
  dateOfService                DateTime? @map("date_of_service") @db.Date
  billedAmountEncrypted        String?   @map("billed_amount") @db.Text
  insurancePaidEncrypted       String?   @map("insurance_paid") @db.Text
  patientPaidEncrypted         String?   @map("patient_paid") @db.Text
  appliedToDeductibleEncrypted String?   @map("applied_to_deductible") @db.Text
  appliedToOopEncrypted        String?   @map("applied_to_oop") @db.Text
  claimStatus                  String    @default("processed") @map("claim_status")
  isInNetwork                  Boolean?  @default(true) @map("is_in_network")
  notesEncrypted               String?   @map("notes") @db.Text
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       InsurancePlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  projection ExpenseProjection? @relation(fields: [projectionId], references: [id], onDelete: SetNull)

  @@index([userId, planId])
  @@index([dateOfService])
  @@map("expense_actuals")
}

model CostAnalysis {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                             String   @map("user_id") @db.Uuid
  planId                             String   @map("plan_id") @db.Uuid
  analysisDate                       DateTime @default(now()) @map("analysis_date")
  // Stores AES-256-GCM ciphertext of the Claude response, per-user salt.
  // Renamed 2026-04-24 from `claudeResponse` to `claudeResponseEncrypted` to
  // match the project-wide `*Encrypted` naming convention. The DB column is
  // also renamed (`claude_response` → `claude_response_encrypted`); see
  // migration `20260424_align_uuid_defaults_and_rename_claude_response`.
  claudeResponseEncrypted            String   @map("claude_response_encrypted") @db.Text
  totalProjectedOopEncrypted         String?  @map("total_projected_oop") @db.Text
  deductibleMetMonth                 Int?     @map("deductible_met_month")
  projectedExpensesSnapshotEncrypted String?  @map("projected_expenses_snapshot") @db.Text
  createdAt                          DateTime @default(now()) @map("created_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan InsurancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, planId])
  @@index([analysisDate])
  @@map("cost_analyses")
}

// ===========================
// LAB CONNECTIONS (FHIR / SMART on FHIR)
// ===========================

model LabConnection {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  // 'quest' today; design supports 'labcorp' and others later without migration.
  provider              String    @db.VarChar(50)
  fhirPatientId         String?   @map("fhir_patient_id") @db.VarChar(255)
  // OAuth tokens are treated as PHI-adjacent — encrypted with the user's
  // per-user key via the existing encryption service.
  accessTokenEncrypted  String    @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  tokenExpiresAt        DateTime? @map("token_expires_at") @db.Timestamptz(6)
  scopeGranted          String?   @map("scope_granted")
  connectedAt           DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastSyncAt            DateTime? @map("last_sync_at") @db.Timestamptz(6)
  // idle | syncing | error
  syncStatus            String    @default("idle") @map("sync_status") @db.VarChar(20)
  syncError             String?   @map("sync_error")
  lastImportedCount     Int       @default(0) @map("last_imported_count")
  isActive              Boolean   @default(true) @map("is_active")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("lab_connections")
}
