generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String              @unique @db.VarChar(255)
  passwordHash             String              @map("password_hash") @db.VarChar(255)
  firstNameEncrypted       String?             @map("first_name_encrypted")
  lastNameEncrypted        String?             @map("last_name_encrypted")
  dateOfBirthEncrypted     String?             @map("date_of_birth_encrypted")
  phoneEncrypted           String?             @map("phone_encrypted")
  addressEncrypted         String?             @map("address_encrypted")
  emailVerified            Boolean             @default(false) @map("email_verified")
  emailVerificationToken   String?             @unique @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires DateTime?           @map("email_verification_expires") @db.Timestamptz(6)
  passwordResetToken       String?             @unique @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires     DateTime?           @map("password_reset_expires") @db.Timestamptz(6)
  pendingEmail             String?             @map("pending_email") @db.VarChar(255)
  emailChangeToken         String?             @unique @map("email_change_token") @db.VarChar(255)
  emailChangeExpires       DateTime?           @map("email_change_expires") @db.Timestamptz(6)
  isActive                 Boolean             @default(true) @map("is_active")
  role                     UserRole            @default(PATIENT)
  failedLoginAttempts      Int                 @default(0) @map("failed_login_attempts")
  lockedUntil              DateTime?           @map("locked_until") @db.Timestamptz(6)
  lastFailedLogin          DateTime?           @map("last_failed_login") @db.Timestamptz(6)
  // M-4: cross-instance access-token cutoff. Any access JWT with iat before this
  // instant is rejected by authenticate() on every replica. Stamped on
  // logout-all / password change+reset / email change / admin deactivation+role
  // change so revocation spans instances, not just the in-memory blacklist.
  tokensValidAfter         DateTime?           @map("tokens_valid_after") @db.Timestamptz(6)
  notificationPreferences  Json                @default("{}") @map("notification_preferences")
  healthProfileEncrypted   String?             @map("health_profile_encrypted")
  plan                     String              @default("FREE") @db.VarChar(20)
  planExpiresAt            DateTime?           @map("plan_expires_at") @db.Timestamptz(6)
  planUpdatedAt            DateTime?           @map("plan_updated_at") @db.Timestamptz(6)
  onboardingCompletedAt    DateTime?           @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt              DateTime?           @map("last_login_at") @db.Timestamptz(6)
  auditLogs                AuditLog[]
  biomarkers               Biomarker[]
  healthGoals              HealthGoal[]
  healthNeeds              HealthNeed[]
  insurancePlans           InsurancePlan[]
  patientRelationships     ProviderPatient[]   @relation("PatientUser")
  providerRelationships    ProviderPatient[]   @relation("ProviderUser")
  sessions                 Session[]
  encryptionKeys           UserEncryptionKey[]
  files                    UserFile[]
  expenseProjections       ExpenseProjection[]
  expenseActuals           ExpenseActual[]
  costAnalyses             CostAnalysis[]
  labConnections           LabConnection[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model UserEncryptionKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  keyType      String    @map("key_type") @db.VarChar(50)
  keyHash      String    @map("key_hash") @db.VarChar(255)
  encryptedKey String    @map("encrypted_key")
  version      Int       @default(1)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyType, version])
  @@index([userId])
  @@map("user_encryption_keys")
}

model ProviderPatient {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId         String                @map("provider_id") @db.Uuid
  patientId          String                @map("patient_id") @db.Uuid
  canViewBiomarkers  Boolean               @default(true) @map("can_view_biomarkers")
  canViewInsurance   Boolean               @default(false) @map("can_view_insurance")
  canViewHealthNeeds Boolean               @default(true) @map("can_view_health_needs")
  canEditData        Boolean               @default(false) @map("can_edit_data")
  relationshipType   ProviderRelationType  @default(PRIMARY_CARE) @map("relationship_type")
  status             ProviderPatientStatus @default(PENDING)
  consentGrantedAt   DateTime?             @map("consent_granted_at") @db.Timestamptz(6)
  consentExpiresAt   DateTime?             @map("consent_expires_at") @db.Timestamptz(6)
  notesEncrypted     String?               @map("notes_encrypted")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  patient            User                  @relation("PatientUser", fields: [patientId], references: [id], onDelete: Cascade)
  provider           User                  @relation("ProviderUser", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, patientId])
  @@index([providerId])
  @@index([patientId])
  @@index([status])
  @@map("provider_patients")
}

model UserFile {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  filename             String      @db.VarChar(255)
  originalFilename     String      @map("original_filename") @db.VarChar(255)
  fileType             String      @map("file_type") @db.VarChar(50)
  fileSize             Int         @map("file_size")
  storageKey           String      @map("storage_key") @db.VarChar(500)
  labName              String?     @map("lab_name") @db.VarChar(255)
  labDate              DateTime?   @map("lab_date") @db.Date
  biomarkersExtracted  Int         @default(0) @map("biomarkers_extracted")
  extractionConfidence Decimal?    @map("extraction_confidence") @db.Decimal(3, 2)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  biomarkers           Biomarker[]
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([labDate])
  @@map("user_files")
}

model Biomarker {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  category             String             @db.VarChar(100)
  name                 String             @db.VarChar(200)
  unit                 String             @db.VarChar(50)
  valueEncrypted       String             @map("value_encrypted")
  notesEncrypted       String?            @map("notes_encrypted")
  normalRangeMin       Decimal            @map("normal_range_min") @db.Decimal(10, 4)
  normalRangeMax       Decimal            @map("normal_range_max") @db.Decimal(10, 4)
  normalRangeSource    String?            @map("normal_range_source") @db.VarChar(200)
  measurementDate      DateTime           @map("measurement_date") @db.Date
  sourceType           DataSourceType     @default(MANUAL) @map("source_type")
  sourceFile           String?            @map("source_file") @db.VarChar(255)
  extractionConfidence Decimal?           @map("extraction_confidence") @db.Decimal(3, 2)
  labName              String?            @map("lab_name") @db.VarChar(200)
  isOutOfRange         Boolean            @default(false) @map("is_out_of_range")
  isAcknowledged       Boolean            @default(false) @map("is_acknowledged")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userFileId           String?            @map("user_file_id") @db.Uuid
  history              BiomarkerHistory[]
  userFile             UserFile?          @relation(fields: [userFileId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category])
  @@index([measurementDate])
  @@index([isOutOfRange])
  @@index([userFileId])
  @@index([userId, category, measurementDate(sort: Desc)], map: "biomarkers_user_category_date_idx")
  @@index([userId, category, measurementDate(sort: Desc)])
  @@index([userId, createdAt])
  @@index([userId, isOutOfRange])
  @@index([userId, sourceType])
  @@map("biomarkers")
}

model BiomarkerHistory {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  biomarkerId     String    @map("biomarker_id") @db.Uuid
  valueEncrypted  String    @map("value_encrypted")
  measurementDate DateTime  @map("measurement_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  biomarker       Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  @@index([biomarkerId])
  @@index([measurementDate])
  @@map("biomarker_history")
}

model InsurancePlan {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  planName                String    @map("plan_name") @db.VarChar(300)
  insurerName             String    @map("insurer_name") @db.VarChar(200)
  planType                PlanType  @map("plan_type")
  planIdNumber            String?   @map("plan_id_number") @db.VarChar(100)
  memberIdEncrypted       String?   @map("member_id_encrypted")
  groupIdEncrypted        String?   @map("group_id_encrypted")
  effectiveDate           DateTime  @map("effective_date") @db.Date
  terminationDate         DateTime? @map("termination_date") @db.Date
  premiumMonthly          Decimal?  @map("premium_monthly") @db.Decimal(10, 2)
  deductibleIndividual    Decimal   @map("deductible_individual") @db.Decimal(10, 2)
  deductibleFamily        Decimal   @map("deductible_family") @db.Decimal(10, 2)
  deductibleMetIndividual Decimal   @default(0) @map("deductible_met_individual") @db.Decimal(10, 2)
  deductibleMetFamily     Decimal   @default(0) @map("deductible_met_family") @db.Decimal(10, 2)
  oopMaxIndividual        Decimal   @map("oop_max_individual") @db.Decimal(10, 2)
  oopMaxFamily            Decimal   @map("oop_max_family") @db.Decimal(10, 2)
  oopMetIndividual        Decimal   @default(0) @map("oop_met_individual") @db.Decimal(10, 2)
  oopMetFamily            Decimal   @default(0) @map("oop_met_family") @db.Decimal(10, 2)

  // Out-of-network financial limits
  deductibleIndividualOutOfNetwork Decimal? @map("deductible_individual_oon") @db.Decimal(10, 2)
  deductibleFamilyOutOfNetwork     Decimal? @map("deductible_family_oon") @db.Decimal(10, 2)
  oopMaxIndividualOutOfNetwork     Decimal? @map("oop_max_individual_oon") @db.Decimal(10, 2)
  oopMaxFamilyOutOfNetwork         Decimal? @map("oop_max_family_oon") @db.Decimal(10, 2)

  // Copays
  copayPrimaryCare     Decimal? @map("copay_primary_care") @db.Decimal(10, 2)
  copaySpecialist      Decimal? @map("copay_specialist") @db.Decimal(10, 2)
  copayUrgentCare      Decimal? @map("copay_urgent_care") @db.Decimal(10, 2)
  copayEmergency       Decimal? @map("copay_emergency") @db.Decimal(10, 2)
  copayTelehealth      Decimal? @map("copay_telehealth") @db.Decimal(10, 2)
  copayLabWork         Decimal? @map("copay_lab_work") @db.Decimal(10, 2)
  copayXray            Decimal? @map("copay_xray") @db.Decimal(10, 2)
  copayAdvancedImaging Decimal? @map("copay_advanced_imaging") @db.Decimal(10, 2)
  coinsuranceRate      Decimal? @map("coinsurance_rate") @db.Decimal(5, 2)

  // Per-service coinsurance (for plans with "X% after deductible" instead of copays)
  coinsurancePrimaryCare     Decimal? @map("coinsurance_primary_care") @db.Decimal(5, 2)
  coinsuranceSpecialist      Decimal? @map("coinsurance_specialist") @db.Decimal(5, 2)
  coinsuranceUrgentCare      Decimal? @map("coinsurance_urgent_care") @db.Decimal(5, 2)
  coinsuranceEmergency       Decimal? @map("coinsurance_emergency") @db.Decimal(5, 2)
  coinsuranceTelehealth      Decimal? @map("coinsurance_telehealth") @db.Decimal(5, 2)
  coinsuranceLabWork         Decimal? @map("coinsurance_lab_work") @db.Decimal(5, 2)
  coinsuranceXray            Decimal? @map("coinsurance_xray") @db.Decimal(5, 2)
  coinsuranceAdvancedImaging Decimal? @map("coinsurance_advanced_imaging") @db.Decimal(5, 2)

  // Inpatient coverage
  inpatientHospitalCopay       Decimal? @map("inpatient_hospital_copay") @db.Decimal(10, 2)
  inpatientHospitalCoinsurance Decimal? @map("inpatient_hospital_coinsurance") @db.Decimal(5, 2)
  inpatientMentalHealthCopay   Decimal? @map("inpatient_mental_health_copay") @db.Decimal(10, 2)
  inpatientMentalCoinsurance   Decimal? @map("inpatient_mental_coinsurance") @db.Decimal(5, 2)
  maternityCopay               Decimal? @map("maternity_copay") @db.Decimal(10, 2)
  maternityCoinsurance         Decimal? @map("maternity_coinsurance") @db.Decimal(5, 2)
  skilledNursingCopay          Decimal? @map("skilled_nursing_copay") @db.Decimal(10, 2)
  skilledNursingCoinsurance    Decimal? @map("skilled_nursing_coinsurance") @db.Decimal(5, 2)
  skilledNursingDaysLimit      Int?     @map("skilled_nursing_days_limit")

  // Outpatient coverage
  outpatientSurgeryCopay       Decimal? @map("outpatient_surgery_copay") @db.Decimal(10, 2)
  outpatientSurgeryCoinsurance Decimal? @map("outpatient_surgery_coinsurance") @db.Decimal(5, 2)
  outpatientMentalHealthCopay  Decimal? @map("outpatient_mental_health_copay") @db.Decimal(10, 2)
  outpatientMentalCoinsurance  Decimal? @map("outpatient_mental_coinsurance") @db.Decimal(5, 2)

  // Rehab/Therapy visit limits
  physicalTherapyVisitsLimit     Int?     @map("physical_therapy_visits_limit")
  occupationalTherapyVisitsLimit Int?     @map("occupational_therapy_visits_limit")
  speechTherapyVisitsLimit       Int?     @map("speech_therapy_visits_limit")
  physicalTherapyCopay           Decimal? @map("physical_therapy_copay") @db.Decimal(10, 2)
  occupationalTherapyCopay       Decimal? @map("occupational_therapy_copay") @db.Decimal(10, 2)
  speechTherapyCopay             Decimal? @map("speech_therapy_copay") @db.Decimal(10, 2)

  // Prescription (Rx) benefits
  rxTier1Copay           Decimal? @map("rx_tier1_copay") @db.Decimal(10, 2)
  rxTier2Copay           Decimal? @map("rx_tier2_copay") @db.Decimal(10, 2)
  rxTier3Copay           Decimal? @map("rx_tier3_copay") @db.Decimal(10, 2)
  rxTier4Copay           Decimal? @map("rx_tier4_copay") @db.Decimal(10, 2)
  rxTier1Coinsurance     Decimal? @map("rx_tier1_coinsurance") @db.Decimal(5, 2)
  rxTier2Coinsurance     Decimal? @map("rx_tier2_coinsurance") @db.Decimal(5, 2)
  rxTier3Coinsurance     Decimal? @map("rx_tier3_coinsurance") @db.Decimal(5, 2)
  rxTier4Coinsurance     Decimal? @map("rx_tier4_coinsurance") @db.Decimal(5, 2)
  rxRetailDaysSupply     Int?     @map("rx_retail_days_supply")
  rxMailOrderDaysSupply  Int?     @map("rx_mail_order_days_supply")
  rxDeductibleIndividual Decimal? @map("rx_deductible_individual") @db.Decimal(10, 2)
  rxDeductibleFamily     Decimal? @map("rx_deductible_family") @db.Decimal(10, 2)
  rxOopMaxIndividual     Decimal? @map("rx_oop_max_individual") @db.Decimal(10, 2)
  rxOopMaxFamily         Decimal? @map("rx_oop_max_family") @db.Decimal(10, 2)

  // Emergency/Ambulance coverage
  ambulanceGroundCopay       Decimal? @map("ambulance_ground_copay") @db.Decimal(10, 2)
  ambulanceGroundCoinsurance Decimal? @map("ambulance_ground_coinsurance") @db.Decimal(5, 2)
  ambulanceAirCopay          Decimal? @map("ambulance_air_copay") @db.Decimal(10, 2)
  ambulanceAirCoinsurance    Decimal? @map("ambulance_air_coinsurance") @db.Decimal(5, 2)

  // Vision coverage
  visionExamCopay         Decimal? @map("vision_exam_copay") @db.Decimal(10, 2)
  visionExamFrequency     String?  @map("vision_exam_frequency") @db.VarChar(100)
  visionLensesAllowance   Decimal? @map("vision_lenses_allowance") @db.Decimal(10, 2)
  visionFramesAllowance   Decimal? @map("vision_frames_allowance") @db.Decimal(10, 2)
  visionContactsAllowance Decimal? @map("vision_contacts_allowance") @db.Decimal(10, 2)

  // Dental coverage
  dentalPreventiveCoinsurance  Decimal? @map("dental_preventive_coinsurance") @db.Decimal(5, 2)
  dentalBasicCoinsurance       Decimal? @map("dental_basic_coinsurance") @db.Decimal(5, 2)
  dentalMajorCoinsurance       Decimal? @map("dental_major_coinsurance") @db.Decimal(5, 2)
  dentalAnnualMax              Decimal? @map("dental_annual_max") @db.Decimal(10, 2)
  dentalDeductible             Decimal? @map("dental_deductible") @db.Decimal(10, 2)
  dentalOrthodontiaCoinsurance Decimal? @map("dental_orthodontia_coinsurance") @db.Decimal(5, 2)
  dentalOrthodontiaLifetimeMax Decimal? @map("dental_orthodontia_lifetime_max") @db.Decimal(10, 2)

  // DME (Durable Medical Equipment) coverage
  dmeCopay       Decimal? @map("dme_copay") @db.Decimal(10, 2)
  dmeCoinsurance Decimal? @map("dme_coinsurance") @db.Decimal(5, 2)

  // Home Health coverage
  homeHealthVisitCopay       Decimal? @map("home_health_visit_copay") @db.Decimal(10, 2)
  homeHealthVisitCoinsurance Decimal? @map("home_health_visit_coinsurance") @db.Decimal(5, 2)
  homeHealthVisitLimit       Int?     @map("home_health_visit_limit")

  // Hospice coverage
  hospiceInpatientCopay       Decimal? @map("hospice_inpatient_copay") @db.Decimal(10, 2)
  hospiceInpatientCoinsurance Decimal? @map("hospice_inpatient_coinsurance") @db.Decimal(5, 2)
  hospiceRespiteCopay         Decimal? @map("hospice_respite_copay") @db.Decimal(10, 2)
  hospiceRespiteCoinsurance   Decimal? @map("hospice_respite_coinsurance") @db.Decimal(5, 2)
  hospiceRespiteDayLimit      Int?     @map("hospice_respite_day_limit")

  // Additional therapy types
  chiropracticCopay         Decimal? @map("chiropractic_copay") @db.Decimal(10, 2)
  chiropracticVisitsLimit   Int?     @map("chiropractic_visits_limit")
  acupunctureCopay          Decimal? @map("acupuncture_copay") @db.Decimal(10, 2)
  acupunctureVisitsLimit    Int?     @map("acupuncture_visits_limit")
  cardiacRehabCopay         Decimal? @map("cardiac_rehab_copay") @db.Decimal(10, 2)
  cardiacRehabVisitsLimit   Int?     @map("cardiac_rehab_visits_limit")
  pulmonaryRehabCopay       Decimal? @map("pulmonary_rehab_copay") @db.Decimal(10, 2)
  pulmonaryRehabVisitsLimit Int?     @map("pulmonary_rehab_visits_limit")

  // Preventive services (JSON array)
  preventiveServicesList String? @map("preventive_services_list") @db.Text

  // Exclusions (what's NOT covered - JSON array)
  exclusionsList String? @map("exclusions_list") @db.Text

  // Prior authorization requirements (JSON array)
  priorAuthRequirements String? @map("prior_auth_requirements") @db.Text

  // Services with limits (JSON array)
  servicesWithLimits String? @map("services_with_limits") @db.Text

  // Extraction metadata
  extractedFromSbc        Boolean             @default(false) @map("extracted_from_sbc")
  sbcExtractionConfidence Decimal?            @map("sbc_extraction_confidence") @db.Decimal(3, 2)
  isActive                Boolean             @default(true) @map("is_active")
  isPrimary               Boolean             @default(false) @map("is_primary")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  benefits                InsuranceBenefit[]
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseProjections      ExpenseProjection[]
  expenseActuals          ExpenseActual[]
  costAnalyses            CostAnalysis[]

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive, isPrimary(sort: Desc)], map: "insurance_plans_user_active_primary_idx")
  @@index([userId, isActive, isPrimary(sort: Desc)])
  @@map("insurance_plans")
}

model InsuranceBenefit {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId                String        @map("plan_id") @db.Uuid
  serviceName           String        @map("service_name") @db.VarChar(300)
  serviceCategory       String        @map("service_category") @db.VarChar(100)
  inNetworkCovered      Boolean       @map("in_network_covered")
  inNetworkCopay        Decimal?      @map("in_network_copay") @db.Decimal(10, 2)
  inNetworkCoinsurance  Decimal?      @map("in_network_coinsurance") @db.Decimal(5, 2)
  inNetworkDeductible   Boolean       @default(true) @map("in_network_deductible_applies")
  outNetworkCovered     Boolean       @map("out_network_covered")
  outNetworkCopay       Decimal?      @map("out_network_copay") @db.Decimal(10, 2)
  outNetworkCoinsurance Decimal?      @map("out_network_coinsurance") @db.Decimal(5, 2)
  outNetworkDeductible  Boolean       @default(true) @map("out_network_deductible_applies")
  limitations           String?
  preAuthRequired       Boolean       @default(false) @map("pre_auth_required")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  plan                  InsurancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([serviceCategory])
  @@map("insurance_benefits")
}

model HealthNeed {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  needType             HealthNeedType   @map("need_type")
  name                 String           @db.VarChar(200)
  descriptionEncrypted String           @map("description_encrypted")
  urgency              Urgency
  status               HealthNeedStatus @default(PENDING)
  relatedBiomarkerIds  String[]         @map("related_biomarker_ids") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt           DateTime?        @map("resolved_at") @db.Timestamptz(6)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([urgency])
  @@map("health_needs")
}

model HealthGoal {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  name                 String                @db.VarChar(200)
  descriptionEncrypted String?               @map("description_encrypted")
  category             String                @db.VarChar(100)
  // Nullable so rows that already have `targetValueEncrypted` can have the
  // plaintext twin nulled out to stop leaking PHI (see migration
  // 20260601_null_plaintext_health_goal_target). Legacy rows without an
  // encrypted value retain the plaintext until a backfill script re-encrypts.
  targetValue          Decimal?              @map("target_value") @db.Decimal(10, 4)
  // Encrypted PHI replacement for targetValue. Numeric goals (target
  // cholesterol, weight, A1c) reveal sensitive health conditions on their
  // own; the Decimal column stays for backward-compat reads until a
  // migration re-encrypts and nulls it. Written by the controller; read
  // path prefers this and falls back to `targetValue` when null.
  targetValueEncrypted String?               @map("target_value_encrypted")
  currentValue         Decimal?              @map("current_value") @db.Decimal(10, 4)
  startValue           Decimal?              @map("start_value") @db.Decimal(10, 4)
  unit                 String                @db.VarChar(50)
  direction            GoalDirection         @default(DECREASE)
  relatedBiomarkerId   String?               @map("related_biomarker_id") @db.Uuid
  startDate            DateTime              @map("start_date") @db.Date
  targetDate           DateTime              @map("target_date") @db.Date
  status               GoalStatus            @default(ACTIVE)
  progress             Decimal               @default(0) @db.Decimal(5, 2)
  milestones           String?
  reminderFrequency    ReminderFrequency?    @map("reminder_frequency")
  lastReminderSent     DateTime?             @map("last_reminder_sent") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(6)
  progressHistory      GoalProgressHistory[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([targetDate])
  @@index([userId, status, targetDate], map: "health_goals_user_status_target_idx")
  @@index([userId, status, targetDate])
  @@map("health_goals")
}

model GoalProgressHistory {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId        String     @map("goal_id") @db.Uuid
  value         Decimal    @db.Decimal(10, 4)
  progress      Decimal    @db.Decimal(5, 2)
  noteEncrypted String?    @map("note_encrypted")
  recordedAt    DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(6)
  goal          HealthGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([recordedAt])
  @@map("goal_progress_history")
}

model AuditLog {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String?     @map("user_id") @db.Uuid
  actorType              ActorType   @map("actor_type")
  ipAddress              String?     @map("ip_address") @db.VarChar(45)
  userAgent              String?     @map("user_agent")
  sessionId              String?     @map("session_id") @db.VarChar(100)
  action                 AuditAction
  resourceType           String      @map("resource_type") @db.VarChar(100)
  resourceId             String?     @map("resource_id") @db.Uuid
  previousValueEncrypted String?     @map("previous_value_encrypted")
  newValueEncrypted      String?     @map("new_value_encrypted")
  // Legacy plaintext metadata (pre-encryption rows). New rows write
  // metadataEncrypted instead; this column is retained read-only for history.
  metadata               String?
  // AES-256-GCM ciphertext of the metadata JSON (system-salt key), so PHI that
  // can ride in metadata (e.g. filenames) is held to the same field-level
  // encryption standard as previous/new values.
  metadataEncrypted      String?     @map("metadata_encrypted")
  success                Boolean     @default(true)
  errorMessage           String?     @map("error_message")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user                   User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@index([createdAt], map: "audit_logs_created_at_asc_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_desc_idx")
  @@index([userId, createdAt(sort: Desc)], map: "audit_logs_user_created_at_idx")
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String
  valueType   String   @default("string") @map("value_type") @db.VarChar(50)
  description String?
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@map("system_config")
}

