{
  "name": "ownmyhealth-backend",
  "version": "1.0.0",
  "description": "Backend API server for OwnMyHealth application",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --config vitest.config.ci.ts",
    "test:rls": "vitest run src/services/rls.test.ts src/services/accountDeletionCascade.test.ts",
    "consolidate:biomarkers": "tsx src/maintenance/consolidateBiomarkerSeries.ts",
    "backfill:goal-values": "tsx src/maintenance/backfillGoalValues.ts",
    "backfill:userfile-names": "tsx src/maintenance/backfillUserFileNames.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google-cloud/documentai": "^9.5.0",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "1.1.1",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/wasm-node": "^4.53.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.60.2",
    "@rollup/rollup-win32-x64-msvc": "^4.53.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.53.3"
  }
}
