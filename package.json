{
  "name": "ownmyhealth-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "serve dist -s -l ${PORT:-3000}",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e:setup": "cd backend && npx tsx scripts/e2e-db.ts seed-standing e2e-test@ownmyhealth.io E2ETestPass123!",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "prepare": "husky"
  },
  "dependencies": {
    "html2canvas-pro": "^1.5.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.344.0",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.5.0",
    "serve": "^14.2.5",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.59.1",
    "@rollup/wasm-node": "^4.53.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.62.2",
    "@rollup/rollup-win32-x64-msvc": "^4.53.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.53.3",
    "dompurify": "^3.4.11"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ],
    "backend/src/**/*.ts": [
      "eslint --fix --max-warnings=0 --config backend/eslint.config.js",
      "bash -c 'cd backend && npx tsc --noEmit'"
    ]
  }
}
